# Copy to .env.local for development. Never commit real values.
DATABASE_URL=postgres://ff:ff@localhost:5432/family_finance

# Auth.js
AUTH_SECRET=            # generate: openssl rand -base64 32
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=         # Google Cloud console → OAuth client (Web)
AUTH_GOOGLE_SECRET=

# The household admin (owner). First Google sign-in with this email bootstraps the household.
HOUSEHOLD_ADMIN_EMAIL=
HOUSEHOLD_NAME="Family Finance"

# Owner authorizations (default off). Cue Flow stays unread until set to true by the owner.
CUE_FLOW_AUTHORIZED=false

# Development/test only. Enables a password-less test sign-in for e2e tests.
# Refused when NODE_ENV=production or DATABASE_URL is not localhost.
AUTH_TEST_MODE=false

# Fictional demo data loader guard (scripts/seed-demo.ts)
DEMO_MODE=false

# Development only: view the dev server through a preview proxy or pane (demo data only).
# Ignored when NODE_ENV=production.
PREVIEW_MODE=false
